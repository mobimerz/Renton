# Copy to .env.local and fill in. Never commit .env.local.

# ---- Contact form (/api/contact) ----
# Which provider sends the email: "brevo", "resend" or "smtp"
MAIL_PROVIDER=brevo

# Sender shown on the email. Must be a sender/domain verified in your provider
# (Brevo: Senders, Domains & Dedicated IPs → Senders).
MAIL_FROM="Renton Website <no-reply@renton.org.in>"
# Who receives enquiries (comma-separated for several)
CONTACT_TO=contact@renton.org.in

# -- Brevo (MAIL_PROVIDER=brevo) --
# Brevo → SMTP & API → API Keys → Generate a new API key (starts with "xkeysib-")
BREVO_API_KEY=
# Optional: also save every enquiry as a contact in this Brevo list (Contacts → Lists → ID).
# Leave empty to only send the email. Create text attributes PHONE, PRODUCT, REQUIREMENTS first.
BREVO_LIST_ID=

# -- Resend (MAIL_PROVIDER=resend) --
RESEND_API_KEY=

# -- SMTP / Nodemailer (MAIL_PROVIDER=smtp) --
SMTP_HOST=
SMTP_PORT=587
# "true" for port 465 (implicit TLS); defaults to true only when SMTP_PORT=465
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
