# Copy to .env.local and fill in. Never commit .env.local.

# ---- Contact form (/api/contact) ----
# Which provider sends the email: "resend" or "smtp"
MAIL_PROVIDER=resend

# Sender shown on the email. For Resend it must use a domain verified in Resend.
MAIL_FROM="Renton Website <no-reply@renton.org.in>"
# Who receives enquiries (comma-separated for several)
CONTACT_TO=contact@renton.org.in

# -- Resend (MAIL_PROVIDER=resend) --
RESEND_API_KEY=

# -- SMTP / Nodemailer (MAIL_PROVIDER=smtp) --
SMTP_HOST=
SMTP_PORT=587
# "true" for port 465 (implicit TLS); defaults to true only when SMTP_PORT=465
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
