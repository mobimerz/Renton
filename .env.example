# Copy to .env.local and fill in. Never commit .env.local.

# ---- Contact form (/api/contact) ----
# Which provider sends the email: "brevo", "resend" or "smtp"
MAIL_PROVIDER=brevo

# Sender shown on the email. Must be a sender/domain verified in your provider
# (Brevo: Senders, Domains & Dedicated IPs → Senders).
MAIL_FROM="Renton Website <no-reply@renton.org.in>"
# Who receives enquiries (comma-separated for several)
CONTACT_TO=contact@renton.org.in

# Optional: absolute URL of the logo shown in the enquiry email.
# Defaults to public/images/email-logo.png served from the GitHub repo (raw.githubusercontent.com).
EMAIL_LOGO_URL=

# -- Brevo (MAIL_PROVIDER=brevo) --
# Brevo → SMTP & API → API Keys → Generate a new API key (starts with "xkeysib-")
BREVO_API_KEY=
# Optional: also save every enquiry as a contact in this Brevo list (Contacts → Lists → ID).
# Leave empty to only send the email. Create text attributes PHONE, PRODUCT, REQUIREMENTS first.
BREVO_LIST_ID=

# -- Resend (MAIL_PROVIDER=resend) --
RESEND_API_KEY=

# -- SMTP / Nodemailer (MAIL_PROVIDER=smtp) --
SMTP_HOST=
SMTP_PORT=587
# "true" for port 465 (implicit TLS); defaults to true only when SMTP_PORT=465
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ---- Admin panel (/admin) ----
# MongoDB connection string (MongoDB Atlas → Connect → Drivers), including the database name:
# mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/renton?retryWrites=true&w=majority
MONGODB_URI=

# Random string, at least 32 characters. Signs the admin login cookie.
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# The single admin login.
ADMIN_EMAIL=
# A bcrypt hash (recommended): node scripts/hash-password.mjs "your-password"
# In .env.local put a backslash before every $ of the hash; on Vercel paste it as-is.
# A plain password also works (compared in constant time).
# "Forgot password" (/admin/forgot) emails a reset link and stores the new password in
# MongoDB, which then overrides this value — it needs MONGODB_URI and the mail vars above set.
ADMIN_PASSWORD=

# Vercel Blob (image uploads). Added automatically when you connect a Blob store to the project
# (Vercel → Storage → Blob). For local dev: `vercel env pull` or copy it from the store's settings.
BLOB_READ_WRITE_TOKEN=
